{
  "manifest_version": 3,
  "name": "课存 · CourseKeep",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "在已登录的知识星球页面识别播放中的课程视频，浏览器内处理并保存授权的 MP4。",
  "permissions": ["storage", "webRequest", "scripting"],
  "host_permissions": ["https://wx.zsxq.com/*", "https://videos.zsxq.com/*", "https://auth.zsxq.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "打开课存下载器"},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'; connect-src 'self' https://videos.zsxq.com"}
}
